# Copy to .env and fill in. Never commit .env.

# who she reports to (their in-game name); they hear the reports when they next spawn in her lobby
EDITH_OWNER=he_is_the_cat
# a Discord channel webhook for reports (toxic players, bug reports); empty: in game only
EDITH_REPORT_WEBHOOK=
# for /edith/brain/library, /reports, /learned, /player (send as ?token= or the x-admin-token header)
ADMIN_TOKEN=

# 4 cores: Whisper, the chat model and Kokoro share them
EDITH_WHISPER_THREADS=2
EDITH_CHAT_THREADS=2
EDITH_VOICE_THREADS=2
# EDITH_CHAT=0 turns her chat model off; EDITH_CHAT_URL / EDITH_CHAT_FILE swap it (a GGUF)

# optional: keep player records in Postgres instead of files in the volume
# DATABASE_URL=

# --profile caddy: the hostname pointing at this machine (HTTPS certificate by Caddy)
EDITH_HOST=edith.example.com
# --profile tunnel: the token of a Cloudflare Tunnel whose public hostname points at http://edith:8000
TUNNEL_TOKEN=
